# Redirect previous About and Contact URLs to their clean public URLs.
RewriteRule ^about-us/?$ /about/ [R=301,L]
RewriteRule ^contact-us/?$ /contact/ [R=301,L]

# 5. Route clean URLs to the files in the 'pages' directory
RewriteRule ^(about|contact|privacy-policy|terms|disclaimer|refund-policy|thank-you|web-development-services)/?$ pages/$1.html [L]

# 6. Route clean URLs to the files in the 'blog' directory
Redirect 301 /blogs/the-new-seo-problem-nobody-is-talking-about https://chameleogfxstudio.com/blogs/website-not-being-cited-by-ai

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blogs/([^/\.]+)/?$ blog/$1.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(website-not-being-cited-by-ai|how-to-build-an-ai-assistant-beginners-guide|how-to-get-your-brand-mentioned-in-ai-search-results)/?$ blog/$1.html [L]

# 7. Route clean URL for blogs listing page
RewriteRule ^blogs/?$ blogs.html [L]
