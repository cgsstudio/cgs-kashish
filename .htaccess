
Options -MultiViews
RewriteEngine On
RewriteBase /

# Keep the shared SMTP credential file readable only by PHP includes.
<Files "smtp-config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

# SEO: Explicitly allow search-engine indexing
# Remove any inherited/server-level robots restriction and send the correct directive.
<IfModule mod_headers.c>
    Header always unset X-Robots-Tag
    Header always set X-Robots-Tag "index, follow"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>




# 1. Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# 2. Force HTTPS (if not already secure)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 3. Redirect /index.html to /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html [NC]
RewriteRule ^index\.html$ https://chameleogfxstudio.com/ [L,R=301]

# Use /career as the public URL and keep the pages folder private in the URL.
RewriteRule ^cgs_home/career/?$ /career [R=301,L]
RewriteCond %{THE_REQUEST} \s/+pages/career\.html(?:[?\s]) [NC]
RewriteRule ^pages/career\.html$ /career [R=301,L,NC]
RewriteRule ^pages/(about|contact)\.html$ /$1/ [R=301,L,NC]
RewriteCond %{THE_REQUEST} \s/+career\.html(?:[?\s]) [NC]
RewriteRule ^career\.html$ /career [R=301,L]
RewriteRule ^career/?$ pages/career.html [L]

# 4. Remove .html from URLs and map extensionless URLs to the real .html file
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html\s [NC]
RewriteRule ^ /%1/ [R=301,L]

# Redirect the legacy root-level Meta Muse Spark URL to its blog URL.
RewriteRule ^what-is-meta-muse-spark-vs-chatgpt-claude-gemini/?$ /blogs/what-is-meta-muse-spark-vs-chatgpt-claude-gemini [R=301,L]

# Map specific extensionless URL for web-development-services (now in pages/ folder)
RewriteRule ^web-development-services/?$ pages/web-development-services.html [L]


